APP_ENV=development
APP_LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173

# 当前 Three-fees 主系统通过内部令牌调用本 AI sidecar。
# 本地开发时请设置一个不少于 16 字符的随机值，并与 Java 后端 AI_SERVICE_TOKEN 保持一致。
AI_SERVICE_TOKEN=change-me-at-least-16-chars

# 生成报告“分析图片”按钮只需要模型能力，不需要初始化 LangGraph 检查点。
AI_INITIALIZE_CHECKPOINTS=false

# AI_PROVIDER=kimi 时调用 Kimi；AI_PROVIDER=fake 用于本地联调，不消耗模型额度。
AI_PROVIDER=kimi
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3
KIMI_EXTRACT_REASONING_EFFORT=low
KIMI_JUDGE_REASONING_EFFORT=high
KIMI_TIMEOUT_SECONDS=90

# zip 原项目完整工作流仍可使用 PostgreSQL；仅分析图片适配接口不依赖这些表。
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=jiangsu_audit_agent
DB_USER=jiangsu_audit_app
DB_PASSWORD=
DB_SCHEMA=audit
LANGGRAPH_SCHEMA=langgraph
FILE_STORAGE_ROOT=data/uploads
MAX_UPLOAD_SIZE_MB=25
