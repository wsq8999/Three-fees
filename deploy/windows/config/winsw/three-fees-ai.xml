<?xml version="1.0" encoding="utf-8"?>
<service>
  <id>three-fees-ai</id>
  <name>Three Fees AI</name>
  <description>智能物业管理系统无状态 Python AI sidecar，仅监听本机回环地址。</description>
  <executable>__DEPLOYMENT_ROOT__\current\ai-service\.venv\Scripts\python.exe</executable>
  <arguments>-m uvicorn app.main:app --host 127.0.0.1 --port 8100 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1</arguments>
  <workingdirectory>__DEPLOYMENT_ROOT__\current\ai-service</workingdirectory>
  <env name="PYTHONUTF8" value="1" />
  <env name="PYTHONUNBUFFERED" value="1" />
  <env name="AI_BIND_HOST" value="127.0.0.1" />
  <env name="AI_BIND_PORT" value="8100" />
  <startmode>Automatic</startmode>
  <delayedAutoStart />
  <stoptimeout>60 sec</stoptimeout>
  <onfailure action="restart" delay="15 sec" />
  <resetfailure>1 hour</resetfailure>
  <serviceaccount>
    <domain>NT AUTHORITY</domain>
    <user>NetworkService</user>
  </serviceaccount>
  <logpath>__DEPLOYMENT_ROOT__\shared\logs\ai</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>10</keepFiles>
  </log>
</service>
