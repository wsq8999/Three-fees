<?xml version="1.0" encoding="utf-8"?>
<service>
  <id>three-fees-worker</id>
  <name>Three Fees Worker</name>
  <description>智能物业管理系统 MySQL 持久任务工作进程。</description>
  <executable>__JAVA_EXE__</executable>
  <arguments>-Dfile.encoding=UTF-8 -Djava.io.tmpdir="__DEPLOYMENT_ROOT__\shared\tmp\worker" -jar "__DEPLOYMENT_ROOT__\current\backend\three-fees-api.jar" --spring.main.web-application-type=none</arguments>
  <workingdirectory>__DEPLOYMENT_ROOT__\current\backend</workingdirectory>
  <env name="SPRING_PROFILES_ACTIVE" value="prod" />
  <env name="SPRING_MAIN_WEB_APPLICATION_TYPE" value="none" />
  <env name="THREE_FEES_PROCESS_ROLE" value="worker" />
  <startmode>Automatic</startmode>
  <delayedAutoStart />
  <stoptimeout>60 sec</stoptimeout>
  <onfailure action="restart" delay="15 sec" />
  <resetfailure>1 hour</resetfailure>
  <serviceaccount>
    <domain>NT AUTHORITY</domain>
    <user>NetworkService</user>
  </serviceaccount>
  <logpath>__DEPLOYMENT_ROOT__\shared\logs\worker</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>10</keepFiles>
  </log>
</service>
