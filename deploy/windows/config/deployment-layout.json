{
  "schemaVersion": 2,
  "defaultDeploymentRoot": "C:\\ProgramData\\ThreeFees",
  "services": [
    {
      "id": "three-fees-api",
      "startMode": "Automatic",
      "bindAddress": "127.0.0.1",
      "port": 8080
    },
    {
      "id": "three-fees-worker",
      "startMode": "Automatic",
      "bindAddress": null,
      "port": null
    }
  ],
  "iis": {
    "publicProxyPrefixes": [
      "/api/",
      "/actuator/health"
    ],
    "blockedPrefixes": [
      "/internal/",
      "/actuator/"
    ]
  }
}
