<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough" />
      <urlCompression doStaticCompression="true" doDynamicCompression="true" />
      <requestFiltering>
        <requestLimits maxAllowedContentLength="4294967295" />
        <hiddenSegments>
          <add segment=".env" />
          <add segment=".git" />
        </hiddenSegments>
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".ps1" allowed="false" />
          <add fileExtension=".psd1" allowed="false" />
          <add fileExtension=".xml" allowed="false" />
        </fileExtensions>
      </requestFiltering>
      <rewrite>
        <rules>
          <rule name="Block internal AI routes" stopProcessing="true">
            <match url="^internal(?:/.*)?$" ignoreCase="true" />
            <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
          </rule>
          <rule name="Proxy public API" stopProcessing="true">
            <match url="^api/(.*)$" ignoreCase="true" />
            <action type="Rewrite" url="http://127.0.0.1:8080/api/{R:1}" appendQueryString="true" />
          </rule>
          <rule name="Proxy public health check" stopProcessing="true">
            <match url="^actuator/health/?$" ignoreCase="true" />
            <action type="Rewrite" url="http://127.0.0.1:8080/actuator/health" appendQueryString="true" />
          </rule>
          <rule name="Block other actuator routes" stopProcessing="true">
            <match url="^actuator(?:/.*)?$" ignoreCase="true" />
            <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
          </rule>
          <rule name="SPA history fallback" stopProcessing="true">
            <match url=".*" />
            <conditions logicalGrouping="MatchAll">
              <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
              <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
              <add input="{URL}" pattern="^/(?:api|actuator|internal)(?:/|$)" negate="true" />
            </conditions>
            <action type="Rewrite" url="/index.html" />
          </rule>
        </rules>
      </rewrite>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="X-Frame-Options" value="DENY" />
          <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
          <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
          <add name="Content-Security-Policy" value="default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'" />
        </customHeaders>
      </httpProtocol>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
        <remove fileExtension=".json" />
        <mimeMap fileExtension=".json" mimeType="application/json" />
        <remove fileExtension=".woff2" />
        <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="assets" inheritInChildApplications="false">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
