{
  "name": "three-fees-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.9.0 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && vite build",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "lint:styles": "stylelint \"src/**/*.{css,vue}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@tiptap/core": "^3.30.3",
    "@tiptap/extension-image": "^3.30.3",
    "@tiptap/extension-text-align": "^3.30.3",
    "@tiptap/starter-kit": "^3.30.3",
    "@tiptap/vue-3": "^3.30.3",
    "docx-preview": "^0.4.0",
    "echarts": "6.1.0",
    "element-plus": "2.14.4",
    "pinia": "3.0.4",
    "vue": "3.5.41",
    "vue-router": "4.6.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "16.5.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9"
  }
}
