{
  "$defs": {
    "ResponseMetadata": {
      "additionalProperties": false,
      "properties": {
        "contractVersion": {
          "const": "1.0",
          "default": "1.0",
          "title": "Contractversion",
          "type": "string"
        },
        "jobId": {
          "title": "Jobid",
          "type": "string"
        },
        "modelProvider": {
          "const": "fake",
          "default": "fake",
          "title": "Modelprovider",
          "type": "string"
        },
        "traceId": {
          "title": "Traceid",
          "type": "string"
        }
      },
      "required": [
        "jobId",
        "traceId"
      ],
      "title": "ResponseMetadata",
      "type": "object"
    },
    "Segment": {
      "additionalProperties": false,
      "properties": {
        "segmentId": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Segmentid",
          "type": "string"
        },
        "text": {
          "maxLength": 30000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "segmentId",
        "text"
      ],
      "title": "Segment",
      "type": "object"
    }
  },
  "$id": "https://three-fees.example/contracts/ai/v1/document-parse-response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "characterCount": {
      "maximum": 120000,
      "minimum": 1,
      "title": "Charactercount",
      "type": "integer"
    },
    "metadata": {
      "$ref": "#/$defs/ResponseMetadata"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/Segment"
      },
      "title": "Segments",
      "type": "array"
    }
  },
  "required": [
    "metadata",
    "segments",
    "characterCount"
  ],
  "title": "DocumentParseResponse",
  "type": "object"
}
