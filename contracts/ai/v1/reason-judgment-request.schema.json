{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "evidenceId": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Evidenceid",
          "type": "string"
        },
        "summary": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "evidenceId",
        "summary"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$",
          "title": "Limit",
          "type": "string"
        },
        "metricCode": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Z0-9_]+$",
          "title": "Metriccode",
          "type": "string"
        },
        "value": {
          "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "metricCode",
        "value",
        "limit"
      ],
      "title": "Metric",
      "type": "object"
    },
    "RequestMetadata": {
      "additionalProperties": false,
      "properties": {
        "contractVersion": {
          "const": "1.0",
          "title": "Contractversion",
          "type": "string"
        },
        "idempotencyKey": {
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Idempotencykey",
          "type": "string"
        },
        "inputSha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Inputsha256",
          "type": "string"
        },
        "jobId": {
          "maxLength": 64,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Jobid",
          "type": "string"
        },
        "traceId": {
          "maxLength": 64,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Traceid",
          "type": "string"
        },
        "workflowVersion": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Workflowversion",
          "type": "string"
        }
      },
      "required": [
        "contractVersion",
        "workflowVersion",
        "jobId",
        "idempotencyKey",
        "inputSha256",
        "traceId"
      ],
      "title": "RequestMetadata",
      "type": "object"
    }
  },
  "$id": "https://three-fees.example/contracts/ai/v1/reason-judgment-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 100,
      "title": "Evidence",
      "type": "array"
    },
    "metadata": {
      "$ref": "#/$defs/RequestMetadata"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/Metric"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Metrics",
      "type": "array"
    }
  },
  "required": [
    "metadata",
    "metrics"
  ],
  "title": "ReasonJudgmentRequest",
  "type": "object"
}
