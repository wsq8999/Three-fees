{
  "$defs": {
    "RequestMetadata": {
      "additionalProperties": false,
      "properties": {
        "contractVersion": {
          "const": "1.0",
          "title": "Contractversion",
          "type": "string"
        },
        "idempotencyKey": {
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Idempotencykey",
          "type": "string"
        },
        "inputSha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Inputsha256",
          "type": "string"
        },
        "jobId": {
          "maxLength": 64,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Jobid",
          "type": "string"
        },
        "traceId": {
          "maxLength": 64,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Traceid",
          "type": "string"
        },
        "workflowVersion": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Workflowversion",
          "type": "string"
        }
      },
      "required": [
        "contractVersion",
        "workflowVersion",
        "jobId",
        "idempotencyKey",
        "inputSha256",
        "traceId"
      ],
      "title": "RequestMetadata",
      "type": "object"
    },
    "Segment": {
      "additionalProperties": false,
      "properties": {
        "segmentId": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Segmentid",
          "type": "string"
        },
        "text": {
          "maxLength": 30000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "segmentId",
        "text"
      ],
      "title": "Segment",
      "type": "object"
    }
  },
  "$id": "https://three-fees.example/contracts/ai/v1/fact-extraction-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowedFieldNames": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Allowedfieldnames",
      "type": "array"
    },
    "metadata": {
      "$ref": "#/$defs/RequestMetadata"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/Segment"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Segments",
      "type": "array"
    }
  },
  "required": [
    "metadata",
    "segments",
    "allowedFieldNames"
  ],
  "title": "FactExtractionRequest",
  "type": "object"
}
