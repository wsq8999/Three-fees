{
  "$defs": {
    "JudgmentInput": {
      "additionalProperties": false,
      "properties": {
        "citedEvidenceIds": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Citedevidenceids",
          "type": "array"
        },
        "overLimit": {
          "title": "Overlimit",
          "type": "boolean"
        },
        "reasonSummary": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Reasonsummary",
          "type": "string"
        }
      },
      "required": [
        "overLimit",
        "reasonSummary"
      ],
      "title": "JudgmentInput",
      "type": "object"
    },
    "ReportFact": {
      "additionalProperties": false,
      "properties": {
        "fieldName": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Fieldname",
          "type": "string"
        },
        "value": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "fieldName",
        "value"
      ],
      "title": "ReportFact",
      "type": "object"
    },
    "RequestMetadata": {
      "additionalProperties": false,
      "properties": {
        "contractVersion": {
          "const": "1.0",
          "title": "Contractversion",
          "type": "string"
        },
        "idempotencyKey": {
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Idempotencykey",
          "type": "string"
        },
        "inputSha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Inputsha256",
          "type": "string"
        },
        "jobId": {
          "maxLength": 64,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Jobid",
          "type": "string"
        },
        "traceId": {
          "maxLength": 64,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Traceid",
          "type": "string"
        },
        "workflowVersion": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Workflowversion",
          "type": "string"
        }
      },
      "required": [
        "contractVersion",
        "workflowVersion",
        "jobId",
        "idempotencyKey",
        "inputSha256",
        "traceId"
      ],
      "title": "RequestMetadata",
      "type": "object"
    }
  },
  "$id": "https://three-fees.example/contracts/ai/v1/report-composition-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowedEvidenceIds": {
      "items": {
        "type": "string"
      },
      "maxItems": 100,
      "title": "Allowedevidenceids",
      "type": "array"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/ReportFact"
      },
      "maxItems": 200,
      "title": "Facts",
      "type": "array"
    },
    "judgment": {
      "$ref": "#/$defs/JudgmentInput"
    },
    "metadata": {
      "$ref": "#/$defs/RequestMetadata"
    }
  },
  "required": [
    "metadata",
    "judgment"
  ],
  "title": "ReportCompositionRequest",
  "type": "object"
}
